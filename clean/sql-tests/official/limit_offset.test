# LIMIT / OFFSET - see SPEC.md's `LIMIT n` / `OFFSET n` section.

statement ok
CREATE TABLE t (x INTEGER)

statement ok
INSERT INTO t VALUES (1)

statement ok
INSERT INTO t VALUES (2)

statement ok
INSERT INTO t VALUES (3)

statement ok
INSERT INTO t VALUES (4)

query I nosort
SELECT x FROM t ORDER BY x LIMIT 2
----
1
2

query I nosort
SELECT x FROM t ORDER BY x OFFSET 2
----
3
4

query I nosort
SELECT x FROM t ORDER BY x LIMIT 50
----
1
2
3
4
