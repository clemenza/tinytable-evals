version 2

# repeat / advance_clock / threshold - SPEC.md's "v2: long-soak" section.
# `repeat` actually runs its body N times; as of #20, `advance_clock` also
# genuinely executes (against the file's own seeded substrate.Simulation
# clock) though nothing reads it yet (no TTL/retention feature exists).
# `threshold` is still grammar-only, pending #21's Grader v2 stats
# plumbing, so run_sql_tests.py reports it as skipped.

statement ok
CREATE TABLE t (x INTEGER)

repeat 20 {
statement ok
INSERT INTO t VALUES (1)

statement ok
DELETE FROM t WHERE x = 1
}

query I nosort
SELECT x FROM t
----

advance_clock 10s

threshold retry_count <= 3
