# explain / assert stats - SPEC.md's "v2: EXPLAIN and assert stats"
# section. `explain` has no `tinytable` feature to run against yet (no
# query planner until milestone 6/#12), so run_sql_tests.py still reports
# it as skipped. `assert stats` genuinely executes as of #21: Database
# gained a stats() interface, so these two are checked for real against
# this file's own table.

statement ok
CREATE TABLE t (x INTEGER)

statement ok
INSERT INTO t VALUES (1)

explain
SELECT x FROM t WHERE x = 1
----
index scan idx

assert stats row_count bounded <= 100

assert stats table_count converges
