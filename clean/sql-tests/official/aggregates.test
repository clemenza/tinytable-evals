# COUNT/MIN/MAX - see SPEC.md's Aggregates section.
# COUNT(*) is exercised against data that includes NULLs: COUNT(*) counts
# every row regardless of column contents.

statement ok
CREATE TABLE people (name TEXT, age INTEGER, dept TEXT)

statement ok
INSERT INTO people VALUES ('Ann', 30, 'eng')

statement ok
INSERT INTO people VALUES ('Bo', 25, 'eng')

statement ok
INSERT INTO people VALUES ('Cy', 40, 'sales')

statement ok
INSERT INTO people VALUES ('Di', NULL, 'sales')

query I nosort
SELECT COUNT(*) FROM people
----
4

# `dept` is fully populated (no NULLs), so COUNT(dept) counts every row.
query I nosort
SELECT COUNT(dept) FROM people
----
4

query I nosort
SELECT COUNT(*) FROM people WHERE dept = 'eng'
----
2

# min/max ignore NULLs.
query I nosort
SELECT MIN(age) FROM people
----
25

query I nosort
SELECT MAX(age) FROM people
----
40

# min/max on an empty result is NULL.
statement ok
CREATE TABLE empty_t (x INTEGER)

statement ok
INSERT INTO empty_t VALUES (1)

query I nosort
SELECT MIN(x) FROM empty_t WHERE x = 999
----
NULL

query I nosort
SELECT MAX(x) FROM empty_t WHERE x = 999
----
NULL

# a fully-populated column is also fine to COUNT(col) directly.
statement ok
CREATE TABLE full_t (x INTEGER)

statement ok
INSERT INTO full_t VALUES (1)

statement ok
INSERT INTO full_t VALUES (2)

statement ok
INSERT INTO full_t VALUES (3)

query I nosort
SELECT COUNT(x) FROM full_t
----
3
